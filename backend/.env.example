FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Local default (sqlite). For Supabase, replace with the Session Pooler URI
# from Supabase dashboard -> Connect -> Connection string -> URI (port 5432,
# NOT the 6543 transaction-pooler port -- SQLAlchemy's psycopg2 driver uses
# server-side prepared statements that break under transaction pooling).
DATABASE_URL=sqlite:///smart_port.db
# DATABASE_URL=postgresql://postgres:<PASSWORD>@<PROJECT-REF>.supabase.co:5432/postgres

CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500

# Frontend origin the OAuth callback redirects back to after login
FRONTEND_URL=http://localhost:5501

# Google OAuth: console.cloud.google.com -> APIs & Services -> Credentials ->
# Create OAuth client ID (Web application). Authorized redirect URI must be:
# http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=

REDIS_URL=redis://localhost:6379/0
